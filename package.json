{
  "name": "arin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:web && cargo build --workspace --locked",
    "build:web": "tsc -b && vite build",
    "test": "vitest run && cargo test --workspace --locked && node --test \"scripts/*.test.mjs\"",
    "test:coverage": "node scripts/coverage.mjs",
    "gen:types": "ARIN_UPDATE_GENERATED=1 cargo test -p arin-core --locked --test generated_types",
    "lint": "tsc -b && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo fmt --check && node scripts/check-boundaries.mjs",
    "app": "tauri build --target aarch64-apple-darwin",
    "app:debug": "tauri build --debug --target aarch64-apple-darwin",
    "dev": "tauri dev",
    "dev:web": "vite",
    "e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "perf": "node scripts/perf/run.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
