{
  "name": "arin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:web && cargo build --workspace --locked",
    "build:web": "tsc -b && vite build",
    "test": "vitest run && cargo test --workspace --locked && node --test \"scripts/*.test.mjs\"",
    "test:coverage": "node scripts/coverage.mjs",
    "gen:types": "ARIN_UPDATE_GENERATED=1 cargo test -p arin-core --locked --test generated_types",
    "lint": "tsc -b && biome lint --error-on-warnings && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo fmt --check && node scripts/check-boundaries.mjs",
    "app": "tauri build --target aarch64-apple-darwin",
    "app:debug": "tauri build --debug --target aarch64-apple-darwin",
    "dev": "tauri dev",
    "dev:web": "vite",
    "e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "perf": "node scripts/perf/run.mjs",
    "licenses": "node scripts/gen-third-party-licenses.mjs",
    "licenses:check": "node scripts/gen-third-party-licenses.mjs --check"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.2",
    "@codemirror/view": "6.43.10",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "@replit/codemirror-vim": "6.4.0",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@codemirror/lint": "6.9.7"
  }
}
